# Copy to .env. Local process runners load it with Node --env-file (see README).
# Defaults below are intentionally public, DEVELOPMENT ONLY, rejected in production.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3000
GATEWAY_PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:5173
# One-node development replica set; directConnection avoids container DNS from host.
MONGODB_URI=mongodb://127.0.0.1:27017/chat?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=chat
MONGODB_POOL_SIZE=20
DEPENDENCY_TIMEOUT_MS=3000
REDIS_URL=redis://:local-only-redis-password@127.0.0.1:6379
RABBITMQ_URL=amqp://chat:local-only-rabbit-password@127.0.0.1:5672/chat
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY=GK00000000000000000000000000000001
S3_SECRET_KEY=local-only-s3-secret-change-before-production
S3_QUARANTINE_BUCKET=chat-quarantine
S3_APPROVED_BUCKET=chat-approved
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Implicit TLS/auth required in production; local Mailpit uses plaintext loopback.
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are production provider secrets, supplied at runtime.
EMAIL_FROM=accounts@commonroom.example.test
# Dedicated encryption key for queued one-use email payloads, separate from CSRF/session key.
AUTH_EMAIL_KEY=local-only-email-encryption-change-before-production
SESSION_DURATION_HOURS=168
AUTH_TOKEN_MINUTES=30
AUTH_RATE_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60
# Measured initial hash budget: 64 MiB x 2 concurrent hashes per API process, t=3, p=1.
ARGON_MEMORY_KIB=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-only-livekit-secret-change-before-production
SESSION_SECRET=local-only-session-secret-change-before-production
COOKIE_SECURE=false
SCANNER_BYPASS=false
# Initial product/cost bounds; raising caps requires validation and measured review.
MAX_MESSAGE_CODEPOINTS=4000
MAX_GROUP_MEMBERS=50
MAX_CONVERSATIONS_PER_USER=500
MAX_BLOCKS_PER_USER=500
GROUP_INVITATION_HOURS=72
MAX_ATTACHMENTS=8
ALLOWED_ATTACHMENT_TYPES=jpeg,png,webp,pdf,text
MAX_ATTACHMENT_BYTES=26214400
MAX_ACCOUNT_ATTACHMENT_BYTES=1073741824
MAX_SESSIONS=10
MAX_CONNECTIONS_PER_SESSION=4
MAX_CALL_PARTICIPANTS=12
MAX_CALL_DURATION_MINUTES=120
MAX_HISTORY_PAGE=100
MAX_SOCKET_BYTES=65536
MAX_LIVE_BUFFER_EVENTS=256
SESSION_RECHECK_SECONDS=30
CALL_TOKEN_SECONDS=120
DOWNLOAD_URL_SECONDS=60
UPLOAD_URL_SECONDS=900
EVENT_RETENTION_DAYS=90
EFFECT_RETENTION_DAYS=180
COMPLETED_OUTBOX_RETENTION_DAYS=180
# 0 means indefinite content retention. Does not disable account deletion workflows.
CONTENT_RETENTION_DAYS=0
MAX_PENDING_OUTBOX=100000
BROKER_PREFETCH=16
BROKER_NAMESPACE=commonroom
BROKER_QUEUE_LIMIT=100000
BROKER_RETRY_ATTEMPTS=5
BROKER_RETRY_BASE_MS=1000
MAX_PENDING_PROJECTIONS=100000
JOB_CONCURRENCY=4
LOG_LEVEL=info

# Public build-time browser hint budget (1..256). Export before web dev/build; contains no secret.
VITE_LIVE_BUFFER_EVENTS=256
