{
  "name": "@chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@chat/config": "workspace:*",
    "@chat/domain": "workspace:*",
    "@chat/contracts": "workspace:*",
    "@chat/observability": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.5",
    "zod": "4.6.7"
  }
}
