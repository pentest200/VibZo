{
  "name": "chat-application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . && tsx scripts/check-boundaries.ts",
    "test": "vitest run --config vitest.config.ts",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "infra:config": "tsx scripts/infra.ts config",
    "infra:up": "tsx scripts/infra.ts up",
    "infra:down": "tsx scripts/infra.ts down",
    "infra:media": "tsx scripts/infra.ts media",
    "infra:scanner": "tsx scripts/infra.ts scanner",
    "test:integration:foundation": "vitest run --config tests/integration/vitest.config.ts",
    "test:integration:infra": "vitest run --config tests/integration/infra-startup.config.ts",
    "test:foundation:http": "vitest run --config tests/http/vitest.config.ts",
    "test:integration:e2e-lifecycle": "vitest run --config tests/integration/e2e-lifecycle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:benchmark": "tsx scripts/auth-benchmark.ts",
    "seed:development": "tsx scripts/seed-development.ts",
    "test:integration:auth": "vitest run --config tests/integration/auth.config.ts",
    "test:e2e:auth": "playwright test --config tests/e2e/playwright.config.ts",
    "test:integration:conversations": "vitest run --config tests/integration/conversations.config.ts",
    "test:e2e:conversations": "playwright test --config tests/e2e/conversations.config.ts",
    "test:integration:messaging": "vitest run --config tests/integration/messaging.config.ts",
    "test:failure:outbox": "vitest run --config tests/integration/outbox.config.ts",
    "ops:replay-dlq": "tsx scripts/replay-dlq.ts",
    "test:e2e:messaging": "playwright test --config tests/e2e/messaging.config.ts",
    "test:integration:sync": "vitest run --config tests/integration/sync.config.ts",
    "test:e2e:sync": "playwright test --config tests/e2e/sync.config.ts",
    "test:failure:gateway": "vitest run --config tests/integration/gateway.config.ts",
    "test:integration:attachments": "vitest run --config tests/integration/attachments.config.ts",
    "test:integration:avatars": "vitest run --config tests/integration/avatars.config.ts",
    "test:e2e:attachments": "playwright test --config tests/e2e/attachments.config.ts",
    "test:e2e:avatars": "playwright test --config tests/e2e/avatars.config.ts",
    "attachments:configure": "tsx scripts/configure-attachments.ts",
    "test:integration:safety": "vitest run --config tests/integration/safety.config.ts",
    "test:e2e:safety": "playwright test --config tests/e2e/safety.config.ts",
    "ops:safety": "tsx scripts/safety-jobs.ts",
    "push:configure": "tsx scripts/configure-push.ts",
    "test:integration:calls": "vitest run --config tests/integration/calls.config.ts",
    "test:e2e:calls": "playwright test --config tests/e2e/calls.config.ts",
    "test:e2e:calls:relay": "playwright test --config tests/e2e/calls-relay.config.ts",
    "test:integration:operations": "vitest run --config tests/integration/operations.config.ts",
    "infra:telemetry": "tsx scripts/infra.ts telemetry",
    "ops:telemetry": "tsx scripts/telemetry-agent.ts",
    "test:failure:dependencies": "vitest run --config tests/integration/dependencies.config.ts",
    "ops:recovery": "tsx scripts/recovery.ts",
    "test:restore": "vitest run --config tests/integration/restore.config.ts",
    "test:upgrade": "vitest run --config tests/integration/upgrade.config.ts",
    "test:e2e:upgrade": "tsx scripts/test-upgrade-media.ts",
    "test:a11y": "playwright test --config tests/e2e/a11y.config.ts",
    "test:e2e:journey": "tsx scripts/test-journey.ts",
    "test:e2e": "tsx scripts/test-browser-gates.ts",
    "test:load:harness": "vitest run --config tests/load/harness.config.ts",
    "test:load:chat": "tsx scripts/test-load.ts chat",
    "test:load:media": "tsx scripts/test-load.ts media",
    "test:load:combined": "tsx scripts/test-load.ts combined"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@axe-core/playwright": "4.14.0",
    "@chat/api": "workspace:*",
    "@chat/config": "workspace:*",
    "@chat/contracts": "workspace:*",
    "@chat/domain": "workspace:*",
    "@chat/gateway": "workspace:*",
    "@chat/observability": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "amqplib": "2.2.0",
    "eslint": "10.12.0",
    "livekit-server-sdk": "2.19.1",
    "mongodb": "7.7.0",
    "redis": "6.3.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
